<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Native AOT from the start: warn at every build about code a trimmed or
         compiled build cannot run. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- The same TagLib# as AlbumWall, which already reads and writes with it
       under Native AOT (spec §7). -->
  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <!-- The version Avalonia ships, so the app carries one copy (as Deadwax). -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Spindle.Core, the helpers the apps share (the submodule at spindle/):
         WebLimits, AppVersion, VersionOrder, ReleaseFeed, LogFile, Diagnostics. -->
    <ProjectReference Include="..\..\spindle\src\Spindle.Core\Spindle.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Spindle" />
  </ItemGroup>

</Project>
