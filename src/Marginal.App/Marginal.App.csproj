<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The executable is the product's name, as everywhere in the family. -->
    <AssemblyName>Marginal</AssemblyName>
    <RootNamespace>Marginal.App</RootNamespace>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- WindowsShell.cs (from Deadwax): source-generated COM
         ([GeneratedComInterface]) for the Start-menu shortcut, the kind
         Native AOT can run, and its buffers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- No DOTNET_STARTUP_HOOKS: it runs managed code from any assembly named
         in the environment inside this process (Deadwax security review
         2026-10-24, M1). -->
    <StartupHookSupport>false</StartupHookSupport>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- The same Avalonia as AlbumWall and Deadwax; one upgrade covers all three. -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Marginal.Core\Marginal.Core.csproj" />
    <ProjectReference Include="..\..\spindle\src\Spindle.Playback\Spindle.Playback.csproj" />
    <!-- Spindle.Install, the install and update code the apps share (told which
         app this is by AppInfo, in Program.Main). -->
    <ProjectReference Include="..\..\spindle\src\Spindle.Install\Spindle.Install.csproj" />
    <!-- Spindle.Ui, the window code the apps share (told how windows are drawn
         on Linux by WindowSystem.NativeWayland, in Program.Main). -->
    <ProjectReference Include="..\..\spindle\src\Spindle.Ui\Spindle.Ui.csproj" />
  </ItemGroup>

  <!-- The icon: Assets/icon.svg is the source; tools/make-icon.cs renders
       app.ico (compiled into the exe: all Windows ever shows) and
       app-icon.png (256 px, embedded plainly for the Linux installer, which
       runs before Avalonia), committed. icon-256.png is the windows' own. -->
  <PropertyGroup>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\icon-256.png" />
    <EmbeddedResource Include="Assets\app-icon.png" LogicalName="app-icon.png" />
  </ItemGroup>

  <!-- TagLibSharp whole, in a trimmed or Native AOT build: it constructs the
       class for a file by reflection, and trimmed it reads nothing (AlbumWall's
       trial AOT build, 2026-10-27, indexed every file as unreadable). -->
  <ItemGroup>
    <TrimmerRootAssembly Include="TagLibSharp" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Spindle" />
    <Using Include="Spindle.Install" />
    <Using Include="Spindle.Ui" />
  </ItemGroup>

</Project>
