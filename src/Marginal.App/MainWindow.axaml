<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:Marginal.App"
        x:Class="Marginal.App.MainWindow"
        x:DataType="app:MainWindow"
        Title="Marginal"
        Width="1360" Height="860" MinWidth="980" MinHeight="580"
        Icon="avares://Marginal/Assets/icon-256.png"
        Background="{DynamicResource Ground}"
        WindowStartupLocation="CenterScreen">
    <!-- Tags & art, as in the mockups. Step 1: everything is read and shown;
         nothing can be written yet, so there is no Pending and no Write. -->
    <Window.Styles>
        <!-- Lists without Fluent's own selection paint; the row draws its own. -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Selected}"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F5F7FA"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Selected}"/>
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="Border.head">
            <Setter Property="Background" Value="{DynamicResource Bar}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style Selector="TextBlock.th">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0.7"/>
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
        </Style>
        <Style Selector="ToggleButton.chip">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#EEF0F3"/>
            <Setter Property="Foreground" Value="{DynamicResource Soft}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Text}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="ToggleButton.seg">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource Panel}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Text}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <!-- The mode tabs: a line under the one that is open. -->
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Soft}"/>
        </Style>
        <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}"/>
        </Style>
        <Style Selector="Button.tab.on">
            <Setter Property="BorderBrush" Value="{DynamicResource Text}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.tab.on:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource Text}"/>
        </Style>
        <Style Selector="GridSplitter.pane">
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ResizeDirection" Value="Columns"/>
        </Style>
        <Style Selector="GridSplitter.pane:pointerover">
            <Setter Property="Background" Value="{DynamicResource Rule}"/>
        </Style>
    </Window.Styles>

    <!-- Rounded corners off the Mac (UseDrawnTitleBar), as Deadwax and
         AlbumWall: the window goes transparent and this border carries the
         ground, clipped to 12 px corners; square when not Normal (ApplyCorners).
         On the Mac it is a plain border and macOS rounds the window itself. -->
    <Border x:Name="Surface" ClipToBounds="True" Background="{DynamicResource Ground}">
    <DockPanel>

        <!-- Mode tabs, and off the Mac the title bar too: the desktop's own
             window buttons, a drag on the bar moves the window and a double
             click maximizes (Deadwax's, 2026-10-31). -->
        <Border x:Name="TopBar" DockPanel.Dock="Top" Background="{DynamicResource Panel}" MinHeight="43"
                BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1" Padding="16,0">
            <DockPanel>
                <StackPanel x:Name="LeftButtons" DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" DockPanel.Dock="Left" Text="Marginal" IsVisible="False" IsHitTestVisible="False"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                <StackPanel x:Name="RightButtons" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center"/>
                <Border x:Name="FromChip" DockPanel.Dock="Right" IsVisible="False" VerticalAlignment="Center"
                        Background="{DynamicResource Desk}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                    <TextBlock x:Name="FromText" Classes="mono soft"/>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="TagsTab" Classes="tab on" Content="Tags &amp; art" Click="OnTab"
                            AutomationProperties.Name="Tags &amp; art, open"/>
                    <Button x:Name="LyricsTab" Classes="tab" Content="Lyrics" Click="OnTab"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Toolbar. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Bar}"
                BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Border BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="FieldsButton" Classes="seg" Content="Fields" IsChecked="True" Click="OnFieldsView"/>
                            <ToggleButton x:Name="RawButton" Classes="seg" Content="Raw frames" Click="OnRawView"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="UndoButton" Classes="tool" Content="Undo" IsEnabled="False" Click="OnUndo"
                            AutomationProperties.Name="Undo the last write"/>
                    <!-- Preferences: Updates and About; a dot when an update waits. -->
                    <Button x:Name="GearButton" Classes="tool" Width="36" Padding="0" HorizontalContentAlignment="Center"
                            ToolTip.Tip="Preferences: updates and about" Click="OnPrefs"
                            AutomationProperties.Name="Preferences">
                        <Panel>
                            <!-- AlbumWall's and Deadwax's gear, the same glyph and size
                                 (Dave, 2026-11-01), in Marginal's ink: the ⚙ character
                                 was each system's own drawing of it. -->
                            <Path Stretch="Uniform" Width="17" Height="17" Fill="{DynamicResource Text}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58
                                        c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96
                                        c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84
                                        c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33
                                        c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58
                                        C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61
                                        l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54
                                        c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54
                                        c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32
                                        c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z
                                        M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/>
                            <Border x:Name="UpdateDot" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Accent}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" IsVisible="False"/>
                        </Panel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="OpenButton" Classes="tool" Content="Open folder…" Click="OnOpenFolder"/>
                    <TextBlock x:Name="RootText" Classes="mono soft" FontSize="12" VerticalAlignment="Center" Margin="4,0"
                               MaxWidth="320" TextTrimming="PrefixCharacterEllipsis"/>
                    <Border Width="1" Height="22" Background="{DynamicResource Rule}" Margin="4,0"/>
                    <Button x:Name="LookupButton" Classes="tool" Content="Look up on MusicBrainz" IsEnabled="False" Click="OnLookup"/>
                    <Button x:Name="ArtButton" Classes="tool" Content="Find art…" IsEnabled="False" Click="OnFindArt"/>
                    <!-- Each clean-up for this album or the whole library; every
                         change goes to Pending first, nothing is written. -->
                    <Button x:Name="CleanButton" Classes="tool" Content="Clean up ▾" IsEnabled="False"
                            AutomationProperties.Name="Clean up">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="Junk tags: ID3v1, APE, store leftovers">
                                    <MenuItem x:Name="JunkAlbumItem" Header="This album" Tag="junk" Click="OnCleanAlbum"/>
                                    <MenuItem Header="Whole library (every change shown first)" Tag="junk" Click="OnCleanLibrary"/>
                                </MenuItem>
                                <MenuItem Header="Dates written in different forms">
                                    <MenuItem x:Name="DatesAlbumItem" Header="This album" Tag="dates" Click="OnCleanAlbum"/>
                                    <MenuItem Header="Whole library (every change shown first)" Tag="dates" Click="OnCleanLibrary"/>
                                </MenuItem>
                                <MenuItem Header="Genres that are numbers (17 is Rock)">
                                    <MenuItem x:Name="GenresAlbumItem" Header="This album" Tag="genres" Click="OnCleanAlbum"/>
                                    <MenuItem Header="Whole library (every change shown first)" Tag="genres" Click="OnCleanLibrary"/>
                                </MenuItem>
                                <MenuItem Header="Purchase info: your Apple ID and name">
                                    <MenuItem x:Name="PurchaseAlbumItem" Header="This album" Tag="purchase" Click="OnCleanAlbum"/>
                                    <MenuItem Header="Whole library (every change shown first)" Tag="purchase" Click="OnCleanLibrary"/>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar. -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bar}"
                BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="16,7">
            <!-- One height for the whole bar (the Empty… button's), everything
                 centred in it, and the dots drawn rather than typed: a ● in the
                 mono font sat above the text beside it (Dave, 2026-10-31). -->
            <DockPanel Height="22">
                <TextBlock DockPanel.Dock="Right" Classes="mono soft" VerticalAlignment="Center" Text="FLAC · ID3v2 · MP4"/>
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource OkText}" VerticalAlignment="Center"
                                 AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock x:Name="BackupText" Classes="mono soft" VerticalAlignment="Center"/>
                        <Button x:Name="EmptyBackupsButton" Classes="tool" Height="22" FontSize="11" Padding="8,0" Content="Empty…" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                AutomationProperties.Name="Empty backups…">
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedLeft">
                                    <StackPanel Spacing="10" MaxWidth="320">
                                        <TextBlock x:Name="EmptyQuestion" TextWrapping="Wrap" LineHeight="19"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Classes="tool" Content="Empty backups" Foreground="{DynamicResource BadText}" Click="OnEmptyBackups"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource OkText}" VerticalAlignment="Center"
                                 AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Classes="mono soft" VerticalAlignment="Center" Text="audio data: never touched"/>
                    </StackPanel>
                    <!-- Said when it changes (Accessibility): what a scan, Write or Undo did. -->
                    <TextBlock x:Name="ScanText" Classes="mono soft" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="Columns">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="200" MaxWidth="480"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="460"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="340" MinWidth="240" MaxWidth="720"/>
            </Grid.ColumnDefinitions>

            <!-- Library. -->
            <Border Grid.Column="0" Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,1,0" Padding="0,14,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="16,0,16,10">
                        <DockPanel>
                            <TextBlock x:Name="AlbumCount" DockPanel.Dock="Right" Classes="mono dim"/>
                            <TextBlock Classes="label" Text="LIBRARY"/>
                        </DockPanel>
                        <TextBox x:Name="FilterBox" PlaceholderText="Filter by artist or album" FontSize="12" Height="32"
                                 AutomationProperties.Name="Filter albums by artist or album"
                                 TextChanged="OnFilterChanged"/>
                        <WrapPanel x:Name="Chips" Orientation="Horizontal">
                            <ToggleButton x:Name="ChipAll" Classes="chip" Content="All" IsChecked="True" Click="OnChip" Margin="0,0,6,6"/>
                            <ToggleButton x:Name="ChipFlac" Classes="chip" Content="FLAC" Click="OnChip" Margin="0,0,6,6"/>
                            <ToggleButton x:Name="ChipMp3" Classes="chip" Content="MP3" Click="OnChip" Margin="0,0,6,6"/>
                            <ToggleButton x:Name="ChipM4a" Classes="chip" Content="M4A" Click="OnChip" Margin="0,0,6,6"/>
                            <ToggleButton x:Name="ChipWork" Classes="chip" Content="Needs work" Click="OnChip" Margin="0,0,6,6"/>
                            <ToggleButton x:Name="ChipPending" Classes="chip" Content="Pending" Click="OnChip" Margin="0,0,6,6" IsVisible="False"/>
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock x:Name="CleanCount" Classes="mono" Foreground="{DynamicResource OkText}" Margin="0,0,10,2"/>
                            <TextBlock x:Name="FixableCount" Classes="mono" Foreground="{DynamicResource WarnText}" Margin="0,0,10,2"/>
                            <TextBlock x:Name="MissingCount" Classes="mono" Foreground="{DynamicResource BadText}" Margin="0,0,10,2"/>
                        </WrapPanel>
                        <!-- Pending across albums: a library-wide clean-up, or edits left
                             in several albums. Review is the Pending chip; one Write and
                             one Undo for all of it. -->
                        <Border x:Name="LibraryPendingBar" IsVisible="False" Background="{DynamicResource Selected}"
                                BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="LibraryPendingText" FontSize="12" FontWeight="Medium" TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <Button x:Name="WriteAllButton" Classes="primary" Height="28" FontSize="12" Margin="0,0,6,0" Click="OnWriteAll"/>
                                    <Button Classes="tool" Height="28" FontSize="12" Content="Discard all" Click="OnDiscardAll"/>
                                </WrapPanel>
                                <!-- Write all's progress here too: with no album open the
                                     album pane's bar is not on screen (Dave, 2026-10-31). -->
                                <StackPanel x:Name="LibraryWriteProgress" IsVisible="False" Spacing="4">
                                    <ProgressBar x:Name="LibraryWriteBar" Height="4" MinHeight="4" Minimum="0" Maximum="1"
                                                 Foreground="{DynamicResource Accent}" Background="#DCE8F7"/>
                                    <TextBlock x:Name="LibraryWriteText" Classes="mono soft"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Panel>
                        <TextBlock x:Name="LibraryHint" Classes="dim" TextWrapping="Wrap" LineHeight="19" Margin="16,0"
                                   Text="Open a folder of albums: FLAC, MP3 or M4A, made by anything."/>
                        <ListBox x:Name="AlbumList" SelectionChanged="OnAlbumSelected" AutomationProperties.Name="Albums">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem" x:DataType="app:AlbumRow">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="app:AlbumRow">
                                    <StackPanel Margin="16,8,16,8" Spacing="3" ToolTip.Tip="{Binding Folder}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                                                    CornerRadius="3" Padding="4,0" VerticalAlignment="Center">
                                                <TextBlock Classes="mono soft" FontSize="10" Text="{Binding Formats}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Classes="pill" Background="{Binding SummaryFill}">
                                                <TextBlock Classes="mono" Foreground="{Binding SummaryText}" Text="{Binding Summary}"/>
                                            </Border>
                                            <TextBlock Classes="dim" FontSize="12" Text="{Binding ArtistYear}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                        </DockPanel>
                                        <!-- Two albums with one title and artist: which folder is which. -->
                                        <TextBlock Classes="mono dim" Text="{Binding FolderName}" IsVisible="{Binding ShowFolder}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Classes="mono" Foreground="{DynamicResource Accent}" Text="{Binding PendingText}"
                                                   IsVisible="{Binding HasPending}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Panel>
                </DockPanel>
            </Border>

            <!-- Album. -->
            <Panel x:Name="AlbumPane" Grid.Column="2">
                <StackPanel x:Name="EmptyAlbum" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="420">
                    <TextBlock Text="No album open" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Classes="dim" TextWrapping="Wrap" TextAlignment="Center" LineHeight="19"
                               Text="Every change you make will wait in Pending until you press Write. Nothing touches a file before then."/>
                </StackPanel>

                <ScrollViewer x:Name="AlbumView" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,18" Spacing="16">
                        <DockPanel>
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="AlbumTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           AutomationProperties.HeadingLevel="1"/>
                                <TextBlock x:Name="AlbumLine" Classes="dim"/>
                                <TextBlock x:Name="AlbumFolder" Classes="mono dim" TextTrimming="PrefixCharacterEllipsis"/>
                                <WrapPanel x:Name="AlbumChips" Margin="-6,4,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Album fields, or the raw frames of the selected track. -->
                        <Border x:Name="FieldsCard" Classes="card">
                            <StackPanel>
                                <Border Classes="head">
                                    <Grid ColumnDefinitions="190,*,270">
                                        <TextBlock Classes="th" Text="ALBUM FIELD"/>
                                        <TextBlock x:Name="ValuesHeader" Grid.Column="1" Classes="th" Text="VALUE ACROSS FILES"/>
                                        <TextBlock Grid.Column="2" Classes="th" Text="STORED AS"/>
                                    </Grid>
                                </Border>
                                <ListBox x:Name="FieldList" SelectionChanged="OnFieldSelected"
                                         AutomationProperties.Name="Album fields: Enter to edit">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem" x:DataType="app:FieldRow">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}"/>
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="app:FieldRow">
                                            <Border BorderBrush="{DynamicResource RowRule}" BorderThickness="0,0,0,1" Padding="14,8">
                                                <Grid ColumnDefinitions="190,*,270">
                                                    <TextBlock Classes="soft" Text="{Binding Label}" VerticalAlignment="Center"/>
                                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Classes="mono" FontSize="12" Foreground="{Binding ValueText}" Text="{Binding Value}"
                                                                   TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <Border Classes="pill" Background="{Binding NoteFill}" IsVisible="{Binding HasNote}">
                                                            <TextBlock Classes="mono" Foreground="{Binding NoteText}" Text="{Binding Note}"/>
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock Grid.Column="2" Classes="mono soft" Text="{Binding Key}"
                                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Editing a field: set it on every file of the album, or remove it.
                             It goes to Pending; nothing is written here. -->
                        <Border x:Name="EditBar" Classes="card" IsVisible="False" Padding="14,10" BorderBrush="{DynamicResource Accent}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0">
                                    <Button x:Name="EditApply" Classes="tool" Content="Set on all files" Click="OnEditApply"/>
                                    <Button x:Name="EditRemove" Classes="tool" Content="Remove" Click="OnEditRemove"/>
                                    <Button Classes="tool" Content="Cancel" Click="OnEditCancel"/>
                                </StackPanel>
                                <TextBlock x:Name="EditLabel" DockPanel.Dock="Left" Width="140" VerticalAlignment="Center" FontWeight="Medium"/>
                                <TextBox x:Name="EditBox" FontFamily="{StaticResource Mono}" FontSize="12" Height="32"
                                         VerticalContentAlignment="Center" KeyDown="OnEditKey"
                                         AutomationProperties.LabeledBy="{Binding #EditLabel}"/>
                            </DockPanel>
                        </Border>

                        <Border x:Name="RawCard" Classes="card" IsVisible="False">
                            <StackPanel>
                                <Border Classes="head">
                                    <DockPanel>
                                        <TextBlock x:Name="RawFileName" DockPanel.Dock="Right" Classes="mono soft"/>
                                        <Grid ColumnDefinitions="200,*">
                                            <TextBlock Classes="th" Text="KEY"/>
                                            <TextBlock Grid.Column="1" Classes="th" Text="VALUE, AS STORED"/>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                                <ItemsControl x:Name="RawList" AutomationProperties.Name="Raw frames of the selected track">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="app:RawRow">
                                            <Border BorderBrush="{DynamicResource RowRule}" BorderThickness="0,0,0,1" Padding="14,6">
                                                <Grid ColumnDefinitions="200,*">
                                                    <TextBlock Classes="mono soft" FontSize="12" Text="{Binding Key}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" Classes="mono" FontSize="12" Text="{Binding Value}"
                                                               Foreground="{Binding ValueText}" TextDecorations="{Binding Decorations}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Tracks. -->
                        <Border Classes="card">
                            <StackPanel>
                                <Border Classes="head">
                                    <Grid ColumnDefinitions="34,*,58,120,72,78,180">
                                        <TextBlock Classes="th" Text="#"/>
                                        <TextBlock Grid.Column="1" Classes="th" Text="TITLE"/>
                                        <TextBlock Grid.Column="2" Classes="th" Text="TIME" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="3" Classes="th" Text="TAGS"/>
                                        <TextBlock Grid.Column="4" Classes="th" Text="ART"/>
                                        <TextBlock Grid.Column="5" Classes="th" Text="LYRICS"/>
                                        <TextBlock Grid.Column="6" Classes="th" Text="CHECK"/>
                                    </Grid>
                                </Border>
                                <ListBox x:Name="TrackList" SelectionChanged="OnTrackSelected" AutomationProperties.Name="Tracks">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem" x:DataType="app:TrackRow">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}"/>
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="app:TrackRow">
                                            <Border BorderBrush="{DynamicResource RowRule}" BorderThickness="0,0,0,1" Padding="14,7">
                                                <Grid ColumnDefinitions="34,*,58,120,72,78,180">
                                                    <TextBlock Classes="mono dim" FontSize="12" Text="{Binding Number}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="2" Classes="mono soft" FontSize="12" Text="{Binding Time}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <TextBlock Grid.Column="3" Classes="mono soft" Text="{Binding Tags}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Classes="mono" Foreground="{Binding ArtText}" Text="{Binding Art}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="5" Classes="pill" Background="{Binding LyricsFill}" HorizontalAlignment="Left">
                                                        <TextBlock Classes="mono" Foreground="{Binding LyricsText}" Text="{Binding Lyrics}"/>
                                                    </Border>
                                                    <Border Grid.Column="6" Classes="pill" Background="{Binding CheckFill}" HorizontalAlignment="Left">
                                                        <TextBlock Classes="mono" Foreground="{Binding CheckText}" Text="{Binding Check}" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Album checks: those not about one track. -->
                        <WrapPanel x:Name="AlbumChecks"/>

                        <!-- Pending: everything waits here until Write (spec §2, rule 1). -->
                        <Border x:Name="PendingCard" Classes="card" IsVisible="False">
                            <StackPanel>
                                <Border Classes="head" Padding="14,10">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                                            <Button Classes="tool" Content="Discard" Click="OnDiscard"/>
                                            <Button x:Name="WriteButton" Classes="primary" Click="OnWrite"/>
                                        </StackPanel>
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="PendingTitle" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="PendingAdds" Classes="mono" Foreground="{DynamicResource OkText}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="PendingChanges" Classes="mono" Foreground="{DynamicResource WarnText}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="PendingRemoves" Classes="mono" Foreground="{DynamicResource BadText}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="PendingNote" Classes="soft" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                    </DockPanel>
                                </Border>
                                <ItemsControl x:Name="PendingList" AutomationProperties.Name="Pending changes">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="app:PendingRow">
                                            <Border BorderBrush="{DynamicResource RowRule}" BorderThickness="0,0,0,1"
                                                    AutomationProperties.Name="{Binding Spoken}">
                                              <Border BorderBrush="{Binding Ink}" BorderThickness="3,0,0,0" Padding="11,6,14,6">
                                                <Grid ColumnDefinitions="86,*,180,*,*">
                                                    <Border Classes="pill" Background="{Binding Fill}" HorizontalAlignment="Left">
                                                        <TextBlock Classes="mono" Foreground="{Binding Ink}" Text="{Binding Kind}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Classes="mono soft" FontSize="12" Text="{Binding File}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="2" Classes="mono soft" FontSize="12" Text="{Binding Key}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="3" Classes="mono dim" FontSize="12" Text="{Binding From}"
                                                               TextDecorations="Strikethrough" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="4" Classes="mono" FontSize="12" Text="{Binding To}" Foreground="{Binding Ink}"
                                                               FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </Grid>
                                              </Border>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- While a Write, Write all or Undo runs: how far it has got (Dave, 2026-10-31). -->
                        <StackPanel x:Name="WriteProgress" IsVisible="False" Spacing="4" Margin="2,0">
                            <ProgressBar x:Name="WriteBar" Height="4" MinHeight="4" Minimum="0" Maximum="1"
                                         Foreground="{DynamicResource Accent}" Background="#DCE8F7"/>
                            <TextBlock x:Name="WriteProgressText" Classes="mono soft"/>
                        </StackPanel>

                        <!-- What the last Write or Undo did, and anything it refused. -->
                        <Border x:Name="ResultBox" Classes="card" IsVisible="False" Padding="14,10">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="ResultTitle" FontWeight="Medium" AutomationProperties.LiveSetting="Assertive"/>
                                <TextBlock x:Name="ResultText" Classes="mono" TextWrapping="Wrap" LineHeight="17"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Panel>

            <!-- Art and the selected file. -->
            <!-- Drag handles: the library and the art panel can be made wider
                 or narrower (Dave's ask, 2026-10-31). -->
            <GridSplitter Grid.Column="1" Classes="pane" AutomationProperties.Name="Library width: arrow keys"/>
            <GridSplitter x:Name="ArtSplitter" Grid.Column="3" Classes="pane" AutomationProperties.Name="Art panel width: arrow keys"/>

            <!-- The Lyrics tab, over the album and art columns. -->
            <app:LyricsPanel x:Name="Lyrics" Grid.Column="2" Grid.ColumnSpan="3" IsVisible="False"/>

            <Border x:Name="ArtPane" Grid.Column="4" Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Rule}" BorderThickness="1,0,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,14" Spacing="14">
                        <TextBlock Classes="label" Text="ART"/>
                        <TextBlock x:Name="ArtHint" Classes="dim" TextWrapping="Wrap" LineHeight="19"
                                   Text="The cover, the back and the art inside each file, side by side."/>
                        <!-- The cover, then the back at its own proportions, both
                             the panel's width; the embedded art only when some file
                             carries it (2026-10-31, Dave's call: an empty "embedded"
                             box on every Deadwax rip was most of the panel). -->
                        <StackPanel x:Name="ArtGrid" Spacing="14" IsVisible="False">
                            <StackPanel Spacing="6">
                                <Border Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Rule}" BorderThickness="1"
                                        CornerRadius="4" ClipToBounds="True">
                                    <Panel>
                                        <TextBlock x:Name="CoverNone" Classes="mono" Foreground="{DynamicResource BadText}" Height="160"
                                                   HorizontalAlignment="Center" TextAlignment="Center" Padding="0,72,0,0"/>
                                        <Image x:Name="CoverImage" Stretch="Uniform" AutomationProperties.Name="Cover"/>
                                    </Panel>
                                </Border>
                                <DockPanel>
                                    <Border x:Name="CoverPill" DockPanel.Dock="Right" Classes="pill">
                                        <TextBlock x:Name="CoverStatus" Classes="mono"/>
                                    </Border>
                                    <StackPanel Spacing="1">
                                        <TextBlock x:Name="CoverName" FontSize="12" FontWeight="Medium"/>
                                        <TextBlock x:Name="CoverInfo" Classes="mono soft"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <Border x:Name="BackFrame" Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Rule}"
                                        BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                    <Image x:Name="BackImage" Stretch="Uniform" AutomationProperties.Name="Back cover"/>
                                </Border>
                                <DockPanel>
                                    <Border x:Name="BackPill" DockPanel.Dock="Right" Classes="pill">
                                        <TextBlock x:Name="BackStatus" Classes="mono"/>
                                    </Border>
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="back.jpg" FontSize="12" FontWeight="Medium"/>
                                        <TextBlock x:Name="BackInfo" Classes="mono soft"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>

                            <DockPanel x:Name="EmbeddedRow">
                                <Border DockPanel.Dock="Left" Width="72" Height="72" Margin="0,0,12,0" Background="{DynamicResource Bar}"
                                        BorderBrush="{DynamicResource Rule}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                    <Image x:Name="EmbeddedImage" Stretch="Uniform" AutomationProperties.Name="Art embedded in the files"/>
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Embedded" FontSize="12" FontWeight="Medium"/>
                                    <TextBlock x:Name="EmbeddedInfo" Classes="mono" TextWrapping="Wrap" LineHeight="15"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource RowRule}"/>

                        <TextBlock Classes="label" Text="SELECTED FILE"/>
                        <TextBlock x:Name="FileName" Classes="mono" FontSize="12" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="FileFacts" AutomationProperties.Name="The selected file">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="app:RawRow">
                                    <Grid ColumnDefinitions="78,*" Margin="0,1">
                                        <TextBlock Classes="mono dim" Text="{Binding Key}"/>
                                        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Value}" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
    </Border>
</Window>
