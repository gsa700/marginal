<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Marginal.App.MainWindow"
        Title="Marginal"
        Width="1280" Height="820" MinWidth="900" MinHeight="560"
        Background="{DynamicResource Ground}"
        WindowStartupLocation="CenterScreen">
    <!-- The main window as in the mockups (Tags & art), empty: nothing opened
         yet, nothing can be written yet (roadmap step 0). The panes are the
         mockup's: Library left, Album centre, Art right, Pending under the
         album, the status bar's promises at the foot. -->
    <DockPanel>

        <!-- Mode tabs. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1" Padding="16,0">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Border BorderBrush="{DynamicResource Text}" BorderThickness="0,0,0,2" Padding="14,10">
                    <TextBlock Text="Tags &amp; art" FontWeight="SemiBold"/>
                </Border>
                <Border BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="14,10">
                    <TextBlock Text="Lyrics" Classes="soft"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Toolbar. Everything but Open folder waits for an album. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Bar}"
                BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Classes="tool" Content="Raw frames" IsEnabled="False"/>
                    <Button Classes="tool" Content="Undo" IsEnabled="False"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="tool" Content="Open folder…"/>
                    <Border Width="1" Height="22" Background="{DynamicResource Rule}" Margin="4,0"/>
                    <Button Classes="tool" Content="Look up on MusicBrainz" IsEnabled="False"/>
                    <Button Classes="tool" Content="Find art…" IsEnabled="False"/>
                    <Button Classes="tool" Content="Clean junk tags" IsEnabled="False"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar: the rules, always on screen. -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bar}"
                BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="16,7">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Classes="mono soft" Text="FLAC · ID3v2 · MP4"/>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Classes="mono" Foreground="{DynamicResource OkText}" Text="●"/>
                        <TextBlock Classes="mono soft" Text="backup: tags + art saved before every write"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Classes="mono" Foreground="{DynamicResource OkText}" Text="●"/>
                        <TextBlock Classes="mono soft" Text="audio data: never touched"/>
                    </StackPanel>
                    <TextBlock Classes="mono soft" Text="undo: 0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="260,*,320">

            <!-- Library. -->
            <Border Grid.Column="0" Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,1,0" Padding="16,14">
                <StackPanel Spacing="10">
                    <TextBlock Classes="label" Text="LIBRARY"/>
                    <TextBlock Classes="dim" TextWrapping="Wrap" LineHeight="19"
                               Text="Open a folder of albums: FLAC, MP3 or M4A, made by anything."/>
                </StackPanel>
            </Border>

            <!-- Album. -->
            <Border Grid.Column="1" Padding="20,18">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="420">
                    <TextBlock Text="No album open" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Classes="dim" TextWrapping="Wrap" TextAlignment="Center" LineHeight="19"
                               Text="Every change you make waits in Pending until you press Write. Nothing touches a file before then."/>
                </StackPanel>
            </Border>

            <!-- Art. -->
            <Border Grid.Column="2" Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Rule}" BorderThickness="1,0,0,0" Padding="16,14">
                <StackPanel Spacing="10">
                    <TextBlock Classes="label" Text="ART"/>
                    <TextBlock Classes="dim" TextWrapping="Wrap" LineHeight="19"
                               Text="The cover, the back and the art inside each file, side by side."/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
